# GigaChat (генерация ответов)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_CA_BUNDLE_FILE=/etc/ssl/certs/ca-certificates.crt

# Локальные эмбеддинги
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Telegram
TELEGRAM_BOT_TOKEN=
# id чата операторов для эскалаций (узнать: добавить бота в группу и написать /chatid)
OPERATORS_CHAT_ID=
